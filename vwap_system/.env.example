# ============================================================
# VWAP Alert System — Cấu hình môi trường
# Copy file này thành .env và điền thông tin thực
# ============================================================

# --- DNSE API (bắt buộc) ---
DNSE_API_KEY=your-api-key-here
DNSE_API_SECRET=your-api-secret-here
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn
DNSE_ENCODING=msgpack

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=dnse.trades

# --- ClickHouse (trùng với docker-compose.yml — node-01) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_DB=vwap

# --- MinIO (trùng compose gốc: cổng 9100 trên host) ---
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=stock-data

# --- Alert Config ---
ALERT_THRESHOLD_PCT=1.5
POLL_INTERVAL_SEC=10

# --- Danh sách mã theo dõi (phân cách bằng dấu phẩy) ---
SYMBOLS=HPG,SSI,VNM,VCB,TCB
